# Optional public video asset URLs used by src/components/VideoSection.tsx.
# VITE_* values are bundled into the browser; never put secrets or credentials here.
# Direct HTTPS URL to an MP4 video file (not an embed page). Leave blank until supplied.
VITE_EDUCATIONAL_VIDEO_URL=
# Direct HTTPS URL to an English WebVTT (.vtt) captions file. Leave blank until supplied.
VITE_EDUCATIONAL_VIDEO_CAPTIONS_EN=
